  "claims": [
    {
      "id": "claim_ba665165d6744162a163a775271868f4",
      "statement": "A single workflow handles both building and deploying the site, triggered by pushes to the default branches, pull requests against them, and manual dispatch.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/pages-deploy.yml#L1-L20",
          "version": "repo-lines-v1:sha256:3b7886fc39d8b1aafe5ef273914f35c5dcddeb904774b74a4a276d266ac7e5fe:"
        }
      ]
    },
    {
      "id": "claim_bb07ce3440f3466ea2d33770fc163df5",
      "statement": "Documentation-only commits to `.gitignore`, `README.md`, or `LICENSE` are excluded from the push trigger so they do not spend a deploy.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/pages-deploy.yml#L3-L10",
          "version": "repo-lines-v1:sha256:a9ecf7e3d0a515699feb5903aa4e96fa4b9a1d8ba92c6b0388d57198ef002b28:"
        }
      ]
    },
    {
      "id": "claim_b8b2899e0ba64538b3c4e1f7b2ab44ca",
      "statement": "Pull requests run the full build and link check but can never publish, because the artefact upload and the deploy job are each independently gated on the event not being a pull request.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/pages-deploy.yml#L64-L77",
          "version": "repo-lines-v1:sha256:4d9eaf17766ec05caf7172a68132e1ae98d26ccf5fc2983f96fb13bc986d8860:"
        }
      ]
    },
    {
      "id": "claim_7b3fd556a6ff49899b433ddd9a01a75f",
      "statement": "The checkout uses `fetch-depth: 0` because the last-modified plugin reads git history per post during the build; a shallow clone would silently make every post appear unmodified rather than failing.",
