        }
      ]
    },
    {
      "id": "claim_913f4c3e56ba40d6b6db3514365238f3",
      "statement": "CI builds with Ruby 3.4 and `bundler-cache: true`, installing and caching gems resolved fresh against the Gemfile on each run.",
